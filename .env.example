# ─── Local Development (Vite / Expo) ──────────────────────────────────────────
# Only public keys and configuration should be here.

# Supabase (Required for Web)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Supabase (Required for Mobile)
# Copy these to mobile/.env
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# Application Config
VITE_SITE_URL="http://localhost:3000"
VITE_STRIPE_ARCHITECT_PRICE_ID="price_..."
VITE_STRIPE_PROJECT_PASS_PRICE_ID="price_..."
VITE_STRIPE_PROMO_CODE="BLUEPRINT35"

# ─── Supabase Edge Function Secrets (Set via Dashboard or CLI) ──────────────
# DO NOT ADD THESE TO YOUR LOCAL .env FILE. Use `supabase secrets set`.

# AI Integration
# GEMINI_API_KEY="AIzaSy..." 

# Stripe Integration
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Integration
# RESEND_API_KEY="re_..."

# Edge Function Configuration
# ALLOWED_ORIGINS="http://localhost:3000,https://bluprntai.com"
# SITE_URL="https://bluprntai.com"
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000
