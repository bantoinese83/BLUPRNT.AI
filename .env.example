# ─── Local Development (Vite / Expo) ──────────────────────────────────────────
# Only public keys and configuration should be here.

# Supabase (Required for Web)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Supabase (Required for Mobile — copy to mobile/.env or EAS env)
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# RevenueCat (Mobile — EAS / mobile/.env)
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY="test_..."
# EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY="appl_..."
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY="goog_..."

# Error monitoring (optional; Sentry DSNs are safe to expose client-side)
# VITE_SENTRY_DSN="https://...@....ingest.sentry.io/..."
# EXPO_PUBLIC_SENTRY_DSN="https://...@....ingest.sentry.io/..."

# Application Config
VITE_SITE_URL="http://localhost:3000"
# Must match Stripe prices (see shared/constants/pricing.ts for display copy).
VITE_STRIPE_ARCHITECT_PRICE_ID="price_..."
VITE_STRIPE_PROJECT_PASS_PRICE_ID="price_..."
VITE_STRIPE_PROMO_CODE="BLUEPRINT35"

# ─── Supabase Edge Function Secrets (Set via Dashboard or CLI) ──────────────
# DO NOT ADD THESE TO YOUR LOCAL .env FILE. Use `supabase secrets set`.

# AI Integration
# GEMINI_API_KEY="AIzaSy..." 

# Stripe Integration
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Integration (send-email Edge Function)
# BREVO_API_KEY="xkeysib-..."

# Edge Function Configuration
# ALLOWED_ORIGINS="http://localhost:3000,https://bluprntai.com"
# SITE_URL="https://bluprntai.com"
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MARKETING_REQUESTS=10
# RATE_LIMIT_MARKETING_WINDOW_MS=3600000
# RATE_LIMIT_AI_REQUESTS=20
# RATE_LIMIT_AI_WINDOW_MS=60000
# Shared rate limits (optional; when set, Edge Functions use Upstash instead of in-memory only)
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
