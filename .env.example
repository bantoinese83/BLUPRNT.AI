# ─── Local Development (Vite / Expo) ──────────────────────────────────────────
# Only public keys and configuration should be here.

# Supabase (Required for Web)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Supabase (Required for Mobile — copy to mobile/.env or EAS env)
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"

# RevenueCat (Mobile — EAS / mobile/.env)
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY="test_..."
# EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY="appl_..."
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY="goog_..."

# RevenueCat MCP (Cursor — project .cursor/mcp.json)
# Create an API v2 secret key in RevenueCat → Project → API keys (write if you will modify resources).
# Export in your shell profile or IDE env (do not commit the key):
# REVENUECAT_API_V2_SECRET_KEY="your_api_v2_secret_key"

# Error monitoring (optional; Sentry DSNs are safe to expose client-side)
# VITE_SENTRY_DSN="https://...@....ingest.sentry.io/..."
# EXPO_PUBLIC_SENTRY_DSN="https://...@....ingest.sentry.io/..."

# Application Config
VITE_SITE_URL="http://localhost:3000"
# Must match Stripe prices (see shared/constants/pricing.ts for display copy).
VITE_STRIPE_ARCHITECT_PRICE_ID="price_..."
# Trailing "h" is required — must match Stripe (see price_1TJeXu… in Dashboard).
VITE_STRIPE_PROJECT_PASS_PRICE_ID="price_1TJeXuDScOjm3APoAAgCO9Hh"
VITE_STRIPE_PROMO_CODE="BLUEPRINT35"

# ─── Supabase Edge Function Secrets (Set via Dashboard or CLI) ──────────────
# DO NOT ADD THESE TO YOUR LOCAL .env FILE. Use `supabase secrets set`.

# AI Integration
# GEMINI_API_KEY="AIzaSy..." 

# Stripe Integration
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# create-checkout allowlist (must mirror VITE_* price IDs used by the client)
# STRIPE_ARCHITECT_PRICE_ID="price_..."
# STRIPE_PROJECT_PASS_PRICE_ID="price_..."
# Optional: Stripe promotion_code id for BLUEPRINT35 (auto-applied after lead capture)
# STRIPE_PROMOTION_CODE_ID="promo_..."
# Optional: comma-separated extra Stripe price IDs
# STRIPE_ALLOWED_PRICE_IDS="price_abc,price_xyz"

# Email Integration (send-email Edge Function)
# BREVO_API_KEY="xkeysib-..."

# Edge Function Configuration
# ALLOWED_ORIGINS="http://localhost:3000,https://bluprntai.com"
# Local dev without ALLOWED_ORIGINS: CORS_RELAX_LOCAL=1 (never in production)
# CORS_RELAX_LOCAL=1
# SITE_URL="https://bluprntai.com"
# RevenueCat webhook: Bearer secret (set one name in Dashboard). Local-only escape hatch:
# REVENUECAT_WEBHOOK_SECRET="..."
# (legacy name also supported: REVENUECAT_WEBHOOK_AUTH_TOKEN)
# REVENUECAT_ALLOW_INSECURE_WEBHOOK=1
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MARKETING_REQUESTS=10
# RATE_LIMIT_MARKETING_WINDOW_MS=3600000
# RATE_LIMIT_AI_REQUESTS=20
# RATE_LIMIT_AI_WINDOW_MS=60000
# Shared rate limits (optional; when set, Edge Functions use Upstash instead of in-memory only)
# UPSTASH_REDIS_REST_URL="https://....upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
