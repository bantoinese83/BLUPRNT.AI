{
  "name": "bluprnt-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build -w web",
    "build:web": "npm run build -w web",
    "preview": "npm run preview -w web",
    "clean": "npm run clean -w web",
    "lint": "eslint web mobile shared --max-warnings 0 && npm run typecheck -w web && npm run typecheck -w mobile",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w mobile",
    "test": "npm run test -w web",
    "check": "npm run lint && npm run test:run && npm run build",
    "test:all": "npm run check && npm run test:coverage && npm run test:e2e",
    "test:run": "npm run test:run -w web",
    "test:coverage": "npm run test:coverage -w web",
    "db:types": "bash scripts/gen-db-types.sh",
    "db:types:check": "bash scripts/check-db-types.sh",
    "test:e2e": "playwright test",
    "functions:check": "bash scripts/check-edge-functions.sh",
    "postdeploy:verify": "bash scripts/post-deploy-verify.sh",
    "test:ui": "npm run test:ui -w web",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css,html}\" \"shared/**/*.ts\" \"mobile/**/*.{ts,tsx}\"",
    "functions:deploy": "supabase functions deploy --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:photo": "supabase functions deploy photo-to-scope --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:invoices": "supabase functions deploy upload-invoice get-invoice --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:project-view": "supabase functions deploy get-project-view --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:delete-account": "supabase functions deploy delete-account --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:stripe-webhook": "supabase functions deploy stripe-webhook --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:revenuecat-webhook": "supabase functions deploy revenuecat-webhook --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:checkout": "supabase functions deploy create-checkout --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:send-email": "supabase functions deploy send-email --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:marketing-lead": "supabase functions deploy submit-marketing-lead --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:chat": "supabase functions deploy chat-with-project --project-ref elucgaegaihkklnfoasm",
    "functions:deploy:rate-limited": "supabase functions deploy photo-to-scope get-document-signed-url send-email upload-invoice delete-account get-invoice create-checkout get-project-view submit-marketing-lead chat-with-project --project-ref elucgaegaihkklnfoasm",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.57.1"
  },
  "lint-staged": {
    "web/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "mobile/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "shared/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  }
}
