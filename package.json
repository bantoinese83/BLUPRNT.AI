{
  "name": "bluprnt-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "status": "node scripts/monorepo-status.mjs",
    "check": "npm run lint && npm run knip:check && npm run test:coverage && npm run build && npm run functions:check",
    "quality": "npm run check",
    "lint": "eslint web mobile shared e2e scripts --max-warnings 0 && npm run typecheck -w shared && npm run typecheck -w web && npm run typecheck -w mobile && node scripts/check-design-token-parity.mjs",
    "lint:fix": "eslint web mobile shared e2e scripts --fix --max-warnings 0",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w web && npm run typecheck -w mobile",
    "test:coverage": "npm run test:coverage -w shared && npm run test:coverage -w web && npm run test:coverage -w mobile",
    "test:run": "npm run test:run -w shared && npm run test:run -w web && npm run test:run -w mobile",
    "build": "npm run build -w web && npm run build -w mobile",
    "knip:check": "npm run knip && npm run knip:mobile && npm run knip:shared",
    "knip": "knip --exclude types,nsTypes,enumMembers,duplicates",
    "knip:mobile": "npm run knip -w mobile",
    "knip:shared": "npm run knip -w shared",
    "functions:check": "bash scripts/check-edge-functions.sh",
    "functions:deploy": "supabase functions deploy --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:photo": "supabase functions deploy photo-to-scope --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:invoices": "supabase functions deploy upload-document get-ledger-entry --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:project-view": "supabase functions deploy get-project-view --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:delete-account": "supabase functions deploy delete-account --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:stripe-webhook": "supabase functions deploy stripe-webhook --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:revenuecat-webhook": "supabase functions deploy revenuecat-webhook --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:checkout": "supabase functions deploy create-checkout --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:send-email": "supabase functions deploy send-email --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:marketing-lead": "supabase functions deploy submit-marketing-lead --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:chat": "supabase functions deploy chat-with-project --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "functions:deploy:rate-limited": "supabase functions deploy photo-to-scope get-document-signed-url send-email upload-document delete-account get-ledger-entry create-checkout get-project-view submit-marketing-lead chat-with-project --project-ref ${SUPABASE_PROJECT_REF:-elucgaegaihkklnfoasm}",
    "prepare": "node -e \"if (process.env.VERCEL || process.env.CI) process.exit(0); const { spawnSync } = require('child_process'); const r = spawnSync('husky', { shell: true, stdio: 'inherit' }); process.exit(r.status ?? 1);\"",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@supabase/supabase-js": "^2.100.1",
    "dotenv": "^17.3.1",
    "expo": "~54.0.33",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "knip": "^5.45.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "tailwindcss": "3.4.19"
  },
  "overrides": {
    "nativewind": {
      "tailwindcss": "3.4.19"
    }
  },
  "lint-staged": {
    "web/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "mobile/app/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "mobile/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "shared/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  }
}
