{
  "expo": {
    "name": "BLUPRNT",
    "slug": "bluprnt",
    "owner": "mlabs83",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ai.bluprnt.mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D5C63"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.bluprnt.mobile",
      "associatedDomains": ["applinks:bluprnt.ai"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1D5C63"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BLUPRNT to use your camera to capture renovation photos for estimates."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BLUPRNT to access your photos so you can pick renovation images for estimates."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BLUPRNT uses your location once to suggest your ZIP code for local cost estimates."
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "base83",
          "project": "bluprntai-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86c5f2a0-cd1c-448b-a6dc-ec12adb91d8f"
      }
    }
  }
}
