{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
  "ignore": ["babel.config.cjs", "metro.config.cjs"],
  "ignoreDependencies": [
    "@expo/vector-icons",
    "clsx",
    "expo-auth-session",
    "expo-crypto",
    "expo-symbols",
    "tailwind-merge",
    "react-dom",
    "react-native-screens",
    "react-native-web",
    "react-native-worklets",
    "expo-updates",
    "expo-system-ui",
    "@react-navigation/bottom-tabs"
  ],
  "ignoreBinaries": ["expo", "eslint", "vitest", "knip"],
  "expo": true
}
