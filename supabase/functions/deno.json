{
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom", "esnext"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@supabase/functions-js": "jsr:@supabase/functions-js@2.100.0",
    "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.49.1",
    "@google/genai": "npm:@google/genai@1.46.0",
    "@upstash/ratelimit": "npm:@upstash/ratelimit@2.0.5",
    "@upstash/redis": "npm:@upstash/redis@1.34.3",
    "stripe": "https://esm.sh/stripe@14?target=denonext",
    "zod": "https://esm.sh/zod@3.23.8",
    "sanitize-html": "npm:sanitize-html@2.13.1",
    "std/assert": "https://deno.land/std@0.203.0/assert/mod.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "require-await"]
    }
  }
}
